# Variables de entorno (plantilla). Copiar como ".env". No subir a git.

# Puerto de escucha (debe coincidir con EXPOSE y con el puerto del dominio en Dokploy)
PORT=4000

# 0.0.0.0: accesible desde Traefik/Dokploy (no 127.0.0.1)
HOST=0.0.0.0

# ---------------------- MongoDB ----------------------
# En Dokploy, host = nombre del servicio MongoDB del proyecto.
DATABASE_URL=mongodb://usuario:contrasena@<host-mongodb>:27017/sistema?authSource=admin

# Secreto para firmar JSON Web Tokens (cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_segura_y_aleatoria
JWT_EXPIRES_IN=8h

# Admin inicial (seed automático al arrancar)
ADMIN_SEED_EMAIL=admin@sysjuridico.com
ADMIN_SEED_PASSWORD=CambiarPassword123!

# ---------------- LexPY (Chat de IA) ----------------
# Proveedor: openai | gemini | openrouter | none
LEXPY_AI_PROVIDER=none
LEXPY_AI_API_KEY=
# openrouter: solo modelos gratuitos (sufijo ":free")
LEXPY_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
LEXPY_APP_URL=https://sysjuridico.local

# Fuentes externas (jurisprudencia/legislación pública)
LEXPY_CSJ_URL=https://www.csj.gov.py
LEXPY_BASELEGAL_URL=https://www.baselegal.com.py

# ----------------- Migración Firebase -> MongoDB -----------------
FIREBASE_SERVICE_ACCOUNT_PATH=./sys-juridico-...-adminsdk-fbsvc-xxxx.json
