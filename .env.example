# ==========================================================
# SysJuridico - Variables de entorno (plantilla)
# Copiar este archivo como ".env" y completar con valores reales.
# NUNCA subir el archivo ".env" real al repositorio.
# ==========================================================

# Puerto donde escucha el servidor (Dokploy inyecta esta variable)
PORT=4000

# Cadena de conexión de MongoDB (host interno en Dokploy)
DATABASE_URL=mongodb://usuario:contrasena@host-interno:27017/nombre_db?authSource=admin

# Secreto para firmar JSON Web Tokens (usar una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_segura_y_aleatoria
JWT_EXPIRES_IN=8h

# Usuario administrador inicial (creado por el seed si no existe ninguno)
ADMIN_SEED_EMAIL=admin@sysjuridico.com
ADMIN_SEED_PASSWORD=CambiarPassword123!

# ---------------- LexPY (Chat de IA) ----------------
# Proveedor de IA: openai | gemini | openrouter | none
LEXPY_AI_PROVIDER=none
LEXPY_AI_API_KEY=
# Si usa 'openrouter', use únicamente modelos gratuitos (sufijo ":free")
LEXPY_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
LEXPY_APP_URL=https://sysjuridico.local

# Fuentes externas de respaldo (jurisprudencia / legislación pública)
LEXPY_CSJ_URL=https://www.csj.gov.py
LEXPY_BASELEGAL_URL=https://www.baselegal.com.py

# ---------------- Migración Firebase -> MongoDB ----------------
# Ruta local al archivo de credenciales de servicio de Firebase (NO subir este archivo a git)
FIREBASE_SERVICE_ACCOUNT_PATH=./sys-juridico-firebase-adminsdk-fbsvc-436ade3197.json
